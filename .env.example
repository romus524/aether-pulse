# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# N8N_WEBHOOK_URL: Production n8n webhook (never a /webhook-test/ URL, never the editor URL).
# Keep this server-side. Do not prefix with VITE_.
N8N_WEBHOOK_URL="https://romusking.app.n8n.cloud/webhook/2edb11ba-0824-48d4-a90c-c82a921444be"
